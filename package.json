{
	"name": "hitori-mahjong",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vite build",
		"cf-typegen": "wrangler types",
		"deploy": "pnpm run build && wrangler deploy",
		"dev": "vite dev",
		"postinstall": "pnpm run cf-typegen",
		"preview": "pnpm run build && vite preview",
		"typecheck": "pnpm run cf-typegen && tsc --noEmit",
		"test": "vitest run",
		"deploy:proxy": "wrangler deploy -c proxy/wrangler.jsonc",
