		"better-sqlite3": "^12.5.0",
		"drizzle-orm": "^0.45.2",
		"solid-js": "^2.0.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.1",
		"@cloudflare/vite-plugin": "^1.70.0",
		"@solidjs/vite-plugin": "^3.0.1",
		"@tailwindcss/vite": "^4.1.13",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^25.6.0",
		"@types/uuid": "^11.0.0",
		"daisyui": "^5.3.10",
